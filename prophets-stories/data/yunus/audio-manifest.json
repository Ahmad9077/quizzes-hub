          "end": 42.620113
        }
      ]
    },
    {
      "id": "yunus-plant",
      "audio": "assets/audio/yunus/05.mp3",
      "duration": 53.54737,
      "cues": [
        {
          "start": 0,
          "end": 26.600408,
          "text": "وأنبت الله على يونس عليه السلام شجرةً من يقطين تظلّه. والظلّ يحجب عنه الشمس. يشرح التفسير أن ذلك كان من لطف الله به."
        },
        {
          "start": 26.600408,
          "end": 53.54737,
          "text": "ويخبرنا القرآن أن الله أرسله إلى مائة ألفٍ من الناس أو أكثر. فآمنوا، ومتّعهم الله بالحياة إلى حين. وهكذا يذكر القرآن رسالته وإيمانهم."
        }
      ],
      "segments": [
        {
          "language": "ar",
