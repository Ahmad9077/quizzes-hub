          "end": 37.679864
        },
        {
          "language": "en",
          "paragraph": 1,
          "start": 37.899864,
          "end": 49.792177
        }
      ]
    },
    {
      "id": "yunus-whale",
      "audio": "assets/audio/yunus/02.mp3",
      "duration": 44.774943,
      "cues": [
        {
          "start": 0,
          "end": 21.680431,
          "text": "ثقلت السفينة، وخاف أهلها الغرق. فأجروا قرعةً ليختاروا مَن يُلقى في البحر لتخفّ السفينة، كما يشرح التفسير."
        },
        {
          "start": 21.680431,
          "end": 44.774717,
          "text": "وقعت القرعة على يونس عليه السلام، فأُلقي في البحر. ثم التقمه الحوت، أي ابتلعه. وهنا تنتقل القصة من السفينة إلى الظلمات."
        }
      ],
      "segments": [
        {
          "language": "ar",
          "paragraph": 0,
          "start": 0,
          "end": 9.76
        },
        {
          "language": "en",
          "paragraph": 0,
          "start": 9.98,
          "end": 21.260431
        },
        {
          "language": "ar",
          "paragraph": 1,
          "start": 21.680431,
          "end": 33.120431
        },
        {
          "language": "en",
          "paragraph": 1,
          "start": 33.340431,
          "end": 44.524717
        }
      ]
    },
    {
      "id": "yunus-prayer",
      "audio": "assets/audio/yunus/03.mp3",
      "duration": 51.323946,
      "cues": [
        {
          "start": 0,
          "end": 22.318299,
          "text": "كان يونس عليه السلام في بطن الحوت، في الظلمات. فنادى ربَّه ودعاه. ويذكر القرآن أن يونس كان من المسبّحين."
        },
        {
          "start": 22.318299,
          "end": 51.323946,
          "text": "أقرّ يونس أن الله وحده المستحق للعبادة، ونزّهه عن كل نقص، واعترف بخطئه. هذا شرحٌ لمعنى دعائه؛ والتسبيح هو تنزيه الله عن النقص."
        }
      ],
      "segments": [
        {
          "language": "ar",
          "paragraph": 0,
          "start": 0,
          "end": 9.6
        },
        {
          "language": "en",
          "paragraph": 0,
          "start": 9.82,
          "end": 21.898299
        },
        {
          "language": "ar",
          "paragraph": 1,
          "start": 22.318299,
          "end": 34.958299
        },
        {
          "language": "en",
          "paragraph": 1,
          "start": 35.178299,
          "end": 51.073946
        }
      ]
    },
    {
      "id": "yunus-shore",
      "audio": "assets/audio/yunus/04.mp3",
      "duration": 42.870113,
      "cues": [
        {
          "start": 0,
          "end": 21.405283,
          "text": "فاستجاب الله ليونس عليه السلام، ونجّاه من الغمّ. والغمّ هو ما كان فيه من شدةٍ وضيق. فخرج من بطن الحوت."
        },
        {
          "start": 21.405283,
          "end": 42.870113,
          "text": "وأُلقي على أرضٍ خالية، وكان مريضًا ضعيفًا. وفي الآية كلمة سقيم، ومعناها مريض. لقد انتهت شدّة البقاء في بطن الحوت."
        }
      ],
      "segments": [
        {
          "language": "ar",
          "paragraph": 0,
          "start": 0,
          "end": 10.56
        },
        {
          "language": "en",
