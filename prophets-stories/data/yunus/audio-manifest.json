    {
      "id": "yunus-departure",
      "audio": "assets/audio/yunus/01.mp3",
      "duration": 50.042177,
      "cues": [
        {
          "start": 0,
          "end": 26.799864,
          "text": "سفينةٌ في البحر، وحوتٌ في الأعماق. كيف خرج يونس عليه السلام من بطن الحوت حيًّا؟ كان يونس رسولًا من رسل الله، وهذه قصّةُ موقفٍ مرّ به."
        },
        {
          "start": 26.799864,
          "end": 50.042177,
          "text": "غادر يونس قومه غاضبًا. ويشرح التفسير أنه تعجّل الخروج قبل أن يأمره الله بذلك. ثم ركب سفينةً ممتلئة بالركّاب والأمتعة."
        }
      ],
      "segments": [
        {
          "language": "ar",
          "paragraph": 0,
          "start": 0,
          "end": 13.2
        },
        {
          "language": "en",
          "paragraph": 0,
          "start": 13.42,
          "end": 26.379864
        },
        {
          "language": "ar",
          "paragraph": 1,
