    {
      "id": "musa-departure",
      "audio": "assets/audio/musa/01.mp3",
      "duration": 48.166939,
      "cues": [
        {
          "start": 0,
          "end": 24.219297,
          "text": "البحر أمامهم، وفرعون وجنوده يتبعونهم. أين سيكون طريق النجاة؟ هذا موقفٌ من قصة النبي موسى عليه السلام وقومه."
        },
        {
          "start": 24.219297,
          "end": 48.166939,
          "text": "تبدأ القصة حين أوحى الله إلى موسى أن يخرج ببني إسرائيل ليلًا. وبنو إسرائيل هم القوم الذين خرجوا معه. وأخبره الله أن فرعون وجنوده سيتبعونهم."
        }
      ],
      "segments": [
        {
          "language": "ar",
          "paragraph": 0,
          "start": 0,
          "end": 10.8
        },
        {
          "language": "en",
          "paragraph": 0,
          "start": 11.02,
          "end": 23.799297
        },
        {
          "language": "ar",
          "paragraph": 1,
          "start": 24.219297,
          "end": 36.779297
        },
        {
          "language": "en",
          "paragraph": 1,
          "start": 36.999297,
          "end": 47.916939
        }
      ]
    },
    {
      "id": "musa-pursuit",
      "audio": "assets/audio/musa/02.mp3",
      "duration": 45.869864,
      "cues": [
        {
          "start": 0,
          "end": 21.522925,
          "text": "جمع فرعون قومه ليتبعوا موسى ومن معه. وعند شروق الشمس، لحقوا بهم. ثم صار الفريقان قريبين حتى رأى كلٌّ منهما الآخر."
        },
        {
          "start": 21.522925,
          "end": 45.869864,
          "text": "خاف أصحاب موسى أن يُدركهم فرعون وجنوده، أي أن يلحقوا بهم ويمسكوا بهم. أمّا موسى عليه السلام فطمأنهم، وكان واثقًا بأن الله سيهديه إلى النجاة."
        }
      ],
      "segments": [
        {
          "language": "ar",
          "paragraph": 0,
          "start": 0,
          "end": 11.92
        },
        {
          "language": "en",
          "paragraph": 0,
          "start": 12.14,
          "end": 21.102925
        },
        {
          "language": "ar",
          "paragraph": 1,
          "start": 21.522925,
          "end": 33.682925
        },
        {
          "language": "en",
          "paragraph": 1,
          "start": 33.902925,
          "end": 45.619864
        }
      ]
    },
    {
      "id": "musa-parting",
      "audio": "assets/audio/musa/03.mp3",
      "duration": 39.377596,
      "cues": [
        {
          "start": 0,
          "end": 18.298141,
          "text": "أوحى الله إلى موسى عليه السلام أن يضرب البحر بعصاه. فضربه كما أمره الله، فانشقّ البحر."
        },
        {
          "start": 18.298141,
          "end": 39.377596,
          "text": "انقسم ماء البحر، فصار فيه طريقٌ يسلكه موسى وقومه. وقع ذلك بأمر الله، فدخلوا إلى الطريق."
        }
      ],
      "segments": [
        {
          "language": "ar",
          "paragraph": 0,
          "start": 0,
          "end": 8.24
        },
        {
          "language": "en",
          "paragraph": 0,
          "start": 8.46,
          "end": 17.878141
        },
        {
          "language": "ar",
          "paragraph": 1,
          "start": 18.298141,
          "end": 27.098141
        },
        {
          "language": "en",
          "paragraph": 1,
          "start": 27.318141,
          "end": 39.127596
        }
      ]
    },
    {
      "id": "musa-crossing",
      "audio": "assets/audio/musa/04.mp3",
      "duration": 45.180816,
      "cues": [
        {
          "start": 0,
          "end": 22.647868,
          "text": "صار كل جزءٍ من ماء البحر المنشقّ كالجبل العظيم. وفي الآية كلمة الطَّوْد، ومعناها الجبل. تخيّل اتساع هذا المشهد كما يصفه القرآن."
        },
        {
          "start": 22.647868,
          "end": 45.180816,
          "text": "ومرّ موسى عليه السلام وقومه عبر البحر، حتى خرجوا منه جميعًا. نجّاهم الله، ولم يتخلّف أحدٌ ممن كان معه."
        }
      ],
      "segments": [
        {
          "language": "ar",
          "paragraph": 0,
          "start": 0,
          "end": 11.36
        },
        {
          "language": "en",
