          "end": 44.930816
        }
      ]
    },
    {
      "id": "musa-rescue",
      "audio": "assets/audio/musa/05.mp3",
      "duration": 40.185329,
      "cues": [
        {
          "start": 0,
          "end": 19.118753,
          "text": "وكان فرعون وقومه قد اقتربوا من المكان. ودخلوا في الطريق الذي سلكه موسى وقومه، كما يشرح التفسير."
        },
        {
          "start": 19.118753,
          "end": 40.185329,
          "text": "ثم أغرق الله فرعون ومن معه في البحر. أمّا موسى عليه السلام ومن معه فقد نجوا جميعًا. وهكذا انتهت هذه المطاردة."
        }
      ],
      "segments": [
        {
          "language": "ar",
