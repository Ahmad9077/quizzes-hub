          "end": 53.118934
        }
      ]
    },
    {
      "id": "ismail-waterskin",
      "audio": "assets/audio/ismail/02.mp3",
      "duration": 46.727846,
      "cues": [
        {
          "start": 0,
          "end": 22.190884,
          "text": "دعا إبراهيم عليه السلام ربّه لأهله في هذا الوادي. وسأل الله أن يجعل قلوبًا من الناس تميل إليهم، وأن يرزقهم من الثمرات."
        },
        {
          "start": 22.190884,
          "end": 46.727846,
          "text": "وكانت أمّ إسماعيل تشرب من الماء الذي معها وترضع طفلها. ثم نفد الماء، أي انتهى. فعطشت وعطش إسماعيل، وبدأت تبحث عمّن يساعدهما."
        }
      ],
      "segments": [
        {
          "language": "ar",
          "paragraph": 0,
          "start": 0,
          "end": 11.52
        },
        {
          "language": "en",
          "paragraph": 0,
          "start": 11.74,
          "end": 21.770884
        },
        {
          "language": "ar",
          "paragraph": 1,
          "start": 22.190884,
          "end": 35.070884
        },
        {
          "language": "en",
          "paragraph": 1,
          "start": 35.290884,
          "end": 46.477846
        }
      ]
    },
    {
      "id": "ismail-hills",
      "audio": "assets/audio/ismail/03.mp3",
      "duration": 45.779229,
      "cues": [
        {
          "start": 0,
          "end": 23.215692,
          "text": "صعدت أمّ إسماعيل إلى الصفا، وهو جبل قريب، ونظرت في الوادي لعلّها ترى أحدًا. لكنها لم ترَ أحدًا، فنزلت وعبرت الوادي إلى المروة."
        },
        {
          "start": 23.215692,
          "end": 45.779229,
          "text": "والمروة جبل آخر. وقفت عليه تبحث أيضًا، ثم كرّرت السير بين الصفا والمروة سبع مرّات. كانت تبحث بجدّ، وطفلها يحتاج إلى الماء."
        }
      ],
      "segments": [
        {
          "language": "ar",
          "paragraph": 0,
          "start": 0,
          "end": 11.84
        },
        {
          "language": "en",
          "paragraph": 0,
          "start": 12.06,
          "end": 22.795692
        },
        {
          "language": "ar",
          "paragraph": 1,
          "start": 23.215692,
          "end": 34.655692
        },
        {
          "language": "en",
          "paragraph": 1,
          "start": 34.875692,
          "end": 45.529229
        }
      ]
    },
    {
      "id": "ismail-spring",
      "audio": "assets/audio/ismail/04.mp3",
      "duration": 51.211202,
      "cues": [
        {
          "start": 0,
          "end": 26.627732,
          "text": "وعند المروة، سمعت أمّ إسماعيل صوتًا. ثم رأت مَلَكًا عند موضع زمزم. وبحث المَلَك في الأرض حتى ظهر الماء. فرزقهما الله ماءً بعد العطش."
        },
        {
          "start": 26.627732,
          "end": 51.211202,
          "text": "جمعت أمّ إسماعيل الماء حول موضعه، وملأت قِربتها منه. والقِربة وعاءٌ لحفظ الماء. فشربت وأرضعت طفلها. هذا الماء هو زمزم."
        }
      ],
      "segments": [
        {
          "language": "ar",
          "paragraph": 0,
          "start": 0,
          "end": 13.12
        },
        {
          "language": "en",
