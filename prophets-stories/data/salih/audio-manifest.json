          "end": 45.599796
        }
      ]
    },
    {
      "id": "salih-saved",
      "audio": "assets/audio/salih/05.mp3",
      "duration": 49.498957,
      "cues": [
        {
          "start": 0,
          "end": 23.954104,
          "text": "ولمّا جاء أمر الله، نجّى صالحًا عليه السلام والذين آمنوا معه برحمته. فلم يصبهم العذاب الذي نزل بالمكذّبين."
        },
        {
          "start": 23.954104,
          "end": 49.498957,
          "text": "وأخذت الذين ظلموا صيحةٌ عظيمة، أي صوتٌ شديد، فهلكوا في ديارهم. وهكذا انتهى أمر الذين كذّبوا صالحًا وخالفوا التحذير بشأن الناقة."
        }
      ],
      "segments": [
