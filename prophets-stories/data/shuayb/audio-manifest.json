      "duration": 53.558118,
      "cues": [
        {
          "start": 0,
          "end": 28.319955,
          "text": "ميزانٌ ومكيال. لماذا ذُكرا في قصة نبي؟ أرسل الله شعيبًا عليه السلام إلى قوم مدين. دعاهم إلى عبادة الله وحده، ونهاهم عن إنقاص حقوق الناس."
        },
        {
          "start": 28.319955,
          "end": 53.558118,
          "text": "كان قومه يُنقصون المكيال والميزان، أي يعطون الناس أقلّ مما يستحقّون عند الكيل والوزن. وكانت عندهم نعمٌ كثيرة، ومع ذلك استمرّوا في هذا الظلم."
        }
      ],
      "segments": [
        {
          "language": "ar",
          "paragraph": 0,
          "start": 0,
          "end": 13.12
        },
        {
          "language": "en",
          "paragraph": 0,
          "start": 13.34,
          "end": 27.899955
        },
        {
          "language": "ar",
          "paragraph": 1,
          "start": 28.319955,
          "end": 40.479955
        },
        {
          "language": "en",
