          "end": 53.308118
        }
      ]
    },
    {
      "id": "shuayb-measure",
      "audio": "assets/audio/shuayb/02.mp3",
      "duration": 54.11551,
      "cues": [
        {
          "start": 0,
          "end": 29.031633,
          "text": "طلب شعيب عليه السلام من قومه أن يُوفوا الكيل والوزن بالعدل. والإيفاء يعني إعطاء المقدار كاملًا، دون نقص. كما نهاهم عن إنقاص أشياء الناس والإفساد في الأرض."
        },
        {
          "start": 29.031633,
          "end": 54.11551,
          "text": "وكان شعيب عليه السلام يحذّر قومه من عذابٍ يحيط بهم إن استمرّوا على ظلمهم. فقد دعاهم إلى عبادة الله وبيّن لهم ما يجب أن يتركوه."
        }
      ],
      "segments": [
        {
          "language": "ar",
          "paragraph": 0,
          "start": 0,
          "end": 13.04
        },
        {
          "language": "en",
          "paragraph": 0,
          "start": 13.26,
          "end": 28.611633
        },
        {
          "language": "ar",
          "paragraph": 1,
          "start": 29.031633,
          "end": 40.871633
        },
        {
          "language": "en",
          "paragraph": 1,
          "start": 41.091633,
          "end": 53.86551
        }
      ]
    },
    {
      "id": "shuayb-threat",
      "audio": "assets/audio/shuayb/03.mp3",
      "duration": 50.936508,
      "cues": [
        {
          "start": 0,
          "end": 25.362812,
          "text": "لم يقبل كبراء القوم المستكبرون دعوة شعيب عليه السلام. والكبراء هنا أصحاب المكانة والنفوذ. هدّدوه هو والذين آمنوا معه بالطرد من قريتهم."
        },
        {
          "start": 25.362812,
          "end": 50.936508,
          "text": "اشترطوا عليهم أن يتّبعوا دين القوم، وإلا أخرجوهم. فرفض شعيب عليه السلام أن يُجبر هو والمؤمنون على ما يكرهونه من ذلك الدين."
        }
      ],
      "segments": [
        {
          "language": "ar",
          "paragraph": 0,
          "start": 0,
          "end": 11.84
        },
        {
          "language": "en",
          "paragraph": 0,
          "start": 12.06,
          "end": 24.942812
        },
        {
          "language": "ar",
          "paragraph": 1,
          "start": 25.362812,
          "end": 36.882812
        },
        {
          "language": "en",
          "paragraph": 1,
          "start": 37.102812,
          "end": 50.686508
        }
      ]
    },
    {
      "id": "shuayb-trust",
      "audio": "assets/audio/shuayb/04.mp3",
      "duration": 49.477778,
      "cues": [
        {
          "start": 0,
          "end": 25.885873,
          "text": "أوضح شعيب عليه السلام أنهم يعتمدون على الله. وسأل ربّه أن يحكم بينه وبين قومه بالحق، أي بالعدل، وهو خير الحاكمين."
        },
        {
          "start": 25.885873,
          "end": 49.477778,
          "text": "وفي المقابل، أخذ الكبراء يحذّرون الناس من اتّباع شعيب، ويزعمون أنهم سيخسرون إن اتّبعوه. ظلّوا يصدّون عن دعوته، بدل أن يستجيبوا لها."
        }
      ],
      "segments": [
        {
          "language": "ar",
          "paragraph": 0,
          "start": 0,
          "end": 11.76
        },
        {
          "language": "en",
