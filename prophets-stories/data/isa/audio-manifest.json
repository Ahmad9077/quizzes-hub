          "end": 53.926259
        }
      ]
    },
    {
      "id": "isa-news",
      "audio": "assets/audio/isa/02.mp3",
      "duration": 58.055193,
      "cues": [
        {
          "start": 0,
          "end": 29.074036,
          "text": "تعجّبت مريم لأنها لم تتزوّج. فأخبرها جبريل أن هذا هيّنٌ على الله، وأن الله سيجعل هذا الولد آيةً للناس ورحمةً منه. والآية هنا علامةٌ على قدرة الله."
        },
        {
          "start": 29.074036,
          "end": 58.055193,
          "text": "حملت مريم بعيسى عليه السلام بأمر الله من غير أب. ثم ابتعدت إلى مكانٍ بعيد عن الناس. وكان ما أخبرها به رسول الله إليها أمرًا قد قضاه الله."
        }
      ],
      "segments": [
        {
          "language": "ar",
          "paragraph": 0,
          "start": 0,
          "end": 14.32
        },
        {
          "language": "en",
          "paragraph": 0,
          "start": 14.54,
          "end": 28.654036
        },
        {
          "language": "ar",
          "paragraph": 1,
