          "end": 57.805193
        }
      ]
    },
    {
      "id": "isa-palm",
      "audio": "assets/audio/isa/03.mp3",
      "duration": 55.043492,
      "cues": [
        {
          "start": 0,
          "end": 26.164444,
          "text": "وعند الولادة، لجأت مريم إلى جذع نخلة، وكانت في شدةٍ وحزن. فجاءها نداءٌ يطمئنها، وأخبرها أن الله جعل تحتها ماءً جاريًا تشرب منه."
        },
        {
          "start": 26.164444,
          "end": 55.043492,
          "text": "وأُمرت أن تهزّ جذع النخلة ليتساقط عليها رطبٌ طريّ، فتأكل وتشرب وتطمئن. كما أُمرت ألا تكلّم الناس في ذلك اليوم. والرطب هو ثمر النخل الطري."
        }
      ],
      "segments": [
        {
          "language": "ar",
          "paragraph": 0,
