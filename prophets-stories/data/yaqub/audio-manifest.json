          "end": 43.160408
        },
        {
          "language": "en",
          "paragraph": 1,
          "start": 43.380408,
          "end": 58.3822
        }
      ]
    },
    {
      "id": "yaqub-road",
      "audio": "assets/audio/yaqub/02.mp3",
      "duration": 45.330726,
      "cues": [
        {
          "start": 0,
          "end": 20.802358,
          "text": "طلب يعقوب عليه السلام من بنيه أن يذهبوا ويبحثوا عن يوسف وأخيه. أراد منهم أن يتحسّسوا خبرهما، أي يجتهدوا في السؤال والبحث عنهما."
        },
        {
          "start": 20.802358,
          "end": 45.330726,
          "text": "ونهى بنيه أن يفقدوا الأمل في رحمة الله وفرجه. فمع شدة حزنه، لم يأمرهم أن يتوقفوا عن البحث؛ كان ينتظر أن يأتي الله بما يسرّه."
        }
      ],
      "segments": [
        {
          "language": "ar",
          "paragraph": 0,
          "start": 0,
          "end": 11.12
        },
        {
          "language": "en",
          "paragraph": 0,
          "start": 11.34,
          "end": 20.382358
        },
        {
          "language": "ar",
          "paragraph": 1,
          "start": 20.802358,
          "end": 32.162358
        },
        {
          "language": "en",
          "paragraph": 1,
          "start": 32.382358,
          "end": 45.080726
        }
      ]
    },
    {
      "id": "yaqub-grain",
      "audio": "assets/audio/yaqub/03.mp3",
      "duration": 50.762834,
      "cues": [
        {
          "start": 0,
          "end": 23.619342,
          "text": "ذهب الإخوة إلى مصر، ودخلوا على يوسف يطلبون الطعام لأهلهم. ولم يكونوا قد عرفوه. ثم سألهم يوسف عمّا فعلوه به وبأخيه من قبل."
        },
        {
          "start": 23.619342,
          "end": 50.762834,
          "text": "أدركوا عندئذٍ أنه يوسف، فأخبرهم بأن الله قد أنعم عليه وعلى أخيه. وعفا عنهم، ودعا لهم بالمغفرة. وهكذا وجد أبناء يعقوب يوسف الذي كانوا يبحثون عنه."
        }
      ],
      "segments": [
        {
          "language": "ar",
          "paragraph": 0,
          "start": 0,
          "end": 11.44
        },
        {
          "language": "en",
          "paragraph": 0,
          "start": 11.66,
          "end": 23.199342
        },
        {
          "language": "ar",
          "paragraph": 1,
          "start": 23.619342,
          "end": 37.859342
        },
        {
          "language": "en",
          "paragraph": 1,
          "start": 38.079342,
          "end": 50.512834
        }
      ]
    },
    {
      "id": "yaqub-shirt",
      "audio": "assets/audio/yaqub/04.mp3",
      "duration": 45.318186,
      "cues": [
        {
          "start": 0,
          "end": 23.197642,
          "text": "أرسل يوسف قميصه مع إخوته إلى أبيه. وأخبرهم أن يضعوه على وجه أبيهم فيعود إليه البصر. وطلب أن يأتوا إليه بجميع أهلهم."
        },
        {
          "start": 23.197642,
          "end": 45.318186,
          "text": "ولما غادرت القافلة، وجد يعقوب رائحة يوسف، قبل أن يصل القميص إليه. كان خبر اللقاء يقترب، بعد ذلك الحزن والانتظار."
        }
      ],
      "segments": [
        {
          "language": "ar",
          "paragraph": 0,
          "start": 0,
          "end": 11.2
        },
        {
          "language": "en",
          "paragraph": 0,
          "start": 11.42,
          "end": 22.777642
        },
        {
          "language": "ar",
          "paragraph": 1,
          "start": 23.197642,
          "end": 34.557642
        },
        {
          "language": "en",
          "paragraph": 1,
          "start": 34.777642,
          "end": 45.068186
        }
      ]
    },
    {
      "id": "yaqub-light",
      "audio": "assets/audio/yaqub/05.mp3",
      "duration": 49.748231,
      "cues": [
        {
          "start": 0,
          "end": 23.693696,
          "text": "وصل البشير، وهو حامل الخبر السارّ، ووضع القميص على وجه يعقوب. فعاد إليه بصره بإذن الله. وتحقّق ما أخبر به يوسف عن القميص."
        },
        {
          "start": 23.693696,
          "end": 49.748231,
          "text": "واعترف الأبناء بخطئهم، وطلبوا من أبيهم أن يسأل الله أن يغفر لهم. فوعدهم يعقوب عليه السلام أن يستغفر لهم ربّه، وهو الغفور الرحيم."
        }
      ],
      "segments": [
        {
          "language": "ar",
          "paragraph": 0,
          "start": 0,
