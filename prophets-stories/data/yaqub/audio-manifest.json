          "end": 49.498231
        }
      ]
    },
    {
      "id": "yaqub-ending",
      "audio": "assets/audio/yaqub/06.mp3",
      "duration": 54.036463,
      "cues": [
        {
          "start": 0,
          "end": 29.28585,
          "text": "ثم رحل يعقوب وأهله إلى يوسف في مصر. استقبل يوسف أبويه وقرّبهما إليه، ورحّب بأهله آمنين. وهكذا جمع الله الأسرة بعد الفراق، وانتهى انتظار اللقاء."
        },
        {
          "start": 29.28585,
          "end": 54.036463,
          "text": "هذه لقطة من قصة يعقوب عليه السلام: أرسل بنيه يبحثون، ثم عاد إليه البصر، ثم اجتمع بيوسف. اضغط على البطاقات لتضع هذه الأحداث بالترتيب."
        }
      ],
