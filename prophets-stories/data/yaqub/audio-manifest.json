      "duration": 58.6322,
      "cues": [
        {
          "start": 0,
          "end": 30.040408,
          "text": "قميصٌ يأتي من بعيد، وبصرٌ يعود! كيف وصل خبر يوسف إلى أبيه يعقوب عليهما السلام؟ تبدأ هذه اللقطة ويعقوب حزين على فراق يوسف، يرجو أن يجمعه الله بأبنائه الغائبين."
        },
        {
          "start": 30.040408,
          "end": 58.6322,
          "text": "اشتدّ حزنه حتى ابيضّت عيناه وفقد بصره. لكنه ظلّ صابرًا، يشكو حزنه إلى الله. لم يكن يعرف كلّ ما يجري ليوسف، وكان يرجو رحمة ربّه."
        }
      ],
      "segments": [
        {
          "language": "ar",
          "paragraph": 0,
          "start": 0,
          "end": 14.48
        },
        {
          "language": "en",
          "paragraph": 0,
          "start": 14.7,
          "end": 29.620408
        },
        {
          "language": "ar",
          "paragraph": 1,
