      "duration": 26.962268,
      "cues": [
        {
          "start": 0,
          "end": 14.042018,
          "text": "أمّا هود عليه السلام، فنجّاه الله برحمته من ذلك العذاب الشديد."
        },
        {
          "start": 14.042018,
          "end": 26.962268,
          "text": "ونجّى معه الذين آمنوا، فلم يصبهم عذاب المكذّبين."
        }
