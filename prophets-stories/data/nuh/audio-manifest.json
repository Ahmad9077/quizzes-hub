      "duration": 51.082608,
      "cues": [
        {
          "start": 0,
          "end": 25.918458,
          "text": "سفينةٌ تسير بين أمواجٍ كالجبال! كيف نجا نوح عليه السلام ومن معه؟ تبدأ قصتنا قبل الطوفان، حين أمر الله نبيَّه نوحًا أن يصنع السفينة."
        },
        {
          "start": 25.918458,
          "end": 51.082608,
          "text": "صنع نوح عليه السلام السفينة بأمر الله وتحت حفظه. وكان بعض كبراء قومه يمرّون به ويسخرون منه، وهو يصنعها. وكبراؤهم هم أصحاب المكانة بينهم."
        }
      ],
      "segments": [
        {
          "language": "ar",
          "paragraph": 0,
          "start": 0,
          "end": 11.52
        },
        {
          "language": "en",
          "paragraph": 0,
          "start": 11.74,
          "end": 25.498458
        },
        {
          "language": "ar",
          "paragraph": 1,
          "start": 25.918458,
          "end": 39.518458
        },
        {
          "language": "en",
          "paragraph": 1,
          "start": 39.738458,
          "end": 50.832608
        }
      ]
    },
    {
      "id": "nuh-boarding",
      "audio": "assets/audio/nuh/02.mp3",
      "duration": 46.030544,
      "cues": [
        {
          "start": 0,
          "end": 20.683832,
          "text": "وحين جاء أمر الله، أمر نوحًا عليه السلام أن يحمل في السفينة من الحيوانات زوجين من كل نوع: ذكرًا وأنثى."
        },
        {
          "start": 20.683832,
          "end": 46.030544,
          "text": "وركب معه الذين آمنوا، وكان عددهم قليلًا. وأمره الله أن يحمل أهله إلا من سبق عليه الحكم بالغرق. فلم يكن كل أهله من المؤمنين."
        }
      ],
      "segments": [
        {
          "language": "ar",
          "paragraph": 0,
          "start": 0,
          "end": 9.04
        },
        {
          "language": "en",
          "paragraph": 0,
          "start": 9.26,
          "end": 20.263832
        },
        {
          "language": "ar",
          "paragraph": 1,
          "start": 20.683832,
          "end": 34.203832
        },
        {
          "language": "en",
          "paragraph": 1,
          "start": 34.423832,
          "end": 45.780544
        }
      ]
    },
    {
      "id": "nuh-flood",
      "audio": "assets/audio/nuh/03.mp3",
      "duration": 49.752018,
      "cues": [
        {
          "start": 0,
          "end": 25.476077,
          "text": "نزل من السماء ماءٌ غزيرٌ متتابع، وتفجّرت الأرض بعيون الماء. والعيون هنا ينابيع يخرج منها الماء. فاجتمع ماء السماء وماء الأرض."
        },
        {
          "start": 25.476077,
          "end": 49.752018,
          "text": "وجرت السفينة بنوح عليه السلام ومن معه وسط أمواجٍ عالية. يصف القرآن تلك الأمواج بأنها كالجبال. وكان الله يحفظ السفينة ومن فيها."
        }
      ],
      "segments": [
        {
          "language": "ar",
          "paragraph": 0,
          "start": 0,
          "end": 12.32
        },
        {
          "language": "en",
          "paragraph": 0,
          "start": 12.54,
          "end": 25.056077
        },
        {
          "language": "ar",
          "paragraph": 1,
          "start": 25.476077,
          "end": 36.676077
        },
        {
          "language": "en",
          "paragraph": 1,
          "start": 36.896077,
          "end": 49.502018
        }
      ]
    },
    {
      "id": "nuh-waves",
      "audio": "assets/audio/nuh/04.mp3",
      "duration": 44.714966,
      "cues": [
        {
          "start": 0,
          "end": 19.642744,
          "text": "كان ابنُ نوحٍ بعيدًا عن السفينة. ناداه نوح عليه السلام ليركب معهم، لكن الابن ظنّ أن جبلًا سيحميه من الماء."
        },
        {
          "start": 19.642744,
          "end": 44.714966,
          "text": "بيّن له نوح أن النجاة يومئذٍ برحمة الله. ثم فصل الموج بينهما، فغرق الابن. أمّا نوح والمؤمنون الذين معه، فحفظهم الله في السفينة."
        }
      ],
      "segments": [
        {
          "language": "ar",
          "paragraph": 0,
          "start": 0,
          "end": 8.8
        },
        {
          "language": "en",
