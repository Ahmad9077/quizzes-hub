          "end": 32.522744
        },
        {
          "language": "en",
          "paragraph": 1,
          "start": 32.742744,
          "end": 44.464966
        }
      ]
    },
    {
      "id": "nuh-rest",
      "audio": "assets/audio/nuh/05.mp3",
      "duration": 44.34102,
      "cues": [
        {
          "start": 0,
          "end": 19.676644,
          "text": "ثم أمر الله الأرض أن تبتلع ماءها، والسماء أن تتوقف عن المطر. فنقص الماء وانحسر، أي بدأ يزول عن الأرض."
        },
        {
          "start": 19.676644,
          "end": 44.34102,
          "text": "واستقرّت السفينة على الجودي، وهو جبلٌ ذكره القرآن. وهكذا نجّى الله نوحًا عليه السلام ومن معه، بعد أن جرت بهم السفينة بين الأمواج."
        }
      ],
      "segments": [
        {
          "language": "ar",
          "paragraph": 0,
          "start": 0,
          "end": 10.16
        },
        {
          "language": "en",
