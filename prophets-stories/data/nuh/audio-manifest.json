          "end": 44.09102
        }
      ]
    },
    {
      "id": "nuh-ending",
      "audio": "assets/audio/nuh/06.mp3",
      "duration": 46.19873,
      "cues": [
        {
          "start": 0,
          "end": 27.445397,
          "text": "وأمر الله نوحًا عليه السلام أن يهبط من السفينة بسلامٍ وبركاتٍ منه. انتهى هذا الموقف: صُنعت السفينة، ثم جرت في الطوفان، ثم استقرّت على الجودي."
        },
        {
          "start": 27.445397,
          "end": 46.19873,
          "text": "هذا موقفٌ من قصة نوح عليه السلام. لنجمع أحداثه بالترتيب: اضغط على ما حدث أولًا، ثم ما جاء بعده، ثم الحدث الأخير."
        }
      ],
