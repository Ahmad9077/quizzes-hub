    },
    {
      "id": "yusuf-bucket",
      "audio": "assets/audio/yusuf/05.mp3",
      "duration": 51.297415,
      "cues": [
        {
          "start": 0,
          "end": 25.608549,
          "text": "مرّت قافلة من المسافرين، وأرسلت من يأتيها بالماء. أنزل الرجل دلوه في البئر، فوجد يوسف. فخرج يوسف من البئر، وانتهى بقاؤه فيها."
        },
        {
          "start": 25.608549,
          "end": 51.297415,
          "text": "لكن المسافرين أخفوا أمره ليجعلوه بضاعةً تُباع. وبِيع يوسف بثمن قليل من الدراهم. ثم حملته القافلة إلى مصر؛ فكانت أمامه مرحلة جديدة من قصته."
        }
      ],
      "segments": [
        {
          "language": "ar",
          "paragraph": 0,
          "start": 0,
          "end": 12.88
        },
        {
          "language": "en",
