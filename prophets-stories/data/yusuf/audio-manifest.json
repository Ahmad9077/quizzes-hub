        }
      ]
    },
    {
      "id": "yusuf-path",
      "audio": "assets/audio/yusuf/02.mp3",
      "duration": 51.077823,
      "cues": [
        {
          "start": 0,
          "end": 25.722177,
          "text": "كان إخوة يوسف يرون أن أباهم يحبّ يوسف وأخاه أكثر منهم. فحسدوه، وأرادوا إبعاده حتى يتفرّغ لهم أبوهم. فاتفقوا على تدبيرٍ يؤذيه."
        },
        {
          "start": 25.722177,
          "end": 51.077823,
          "text": "اقترح أحدهم أن يضعوه في غيابة الجُبّ، أي في موضع خفيّ من البئر، ليلتقطه بعض المسافرين. ثم طلبوا من أبيهم أن يرسل يوسف معهم، ووعدوا أن يحفظوه."
        }
      ],
      "segments": [
        {
          "language": "ar",
          "paragraph": 0,
          "start": 0,
          "end": 12.56
        },
        {
          "language": "en",
          "paragraph": 0,
          "start": 12.78,
          "end": 25.302177
        },
        {
          "language": "ar",
          "paragraph": 1,
          "start": 25.722177,
          "end": 39.162177
        },
        {
          "language": "en",
          "paragraph": 1,
          "start": 39.382177,
          "end": 50.827823
        }
      ]
    },
    {
      "id": "yusuf-well",
      "audio": "assets/audio/yusuf/03.mp3",
      "duration": 46.92712,
      "cues": [
        {
          "start": 0,
          "end": 25.507664,
          "text": "حزن يعقوب لفكرة ذهاب يوسف، وخاف عليه من الذئب إن غفل إخوته عنه. ثم ذهب يوسف معهم. لكنهم لم يفوا بوعدهم، ووضعوه في البئر."
        },
        {
          "start": 25.507664,
          "end": 46.92712,
          "text": "وأوحى الله إلى يوسف أنه سيخبرهم يومًا بما فعلوا، وهم لا يعرفونه. كانت في هذا بشارةٌ له بأنه سينجو من ذلك الموقف الصعب."
        }
      ],
      "segments": [
        {
          "language": "ar",
          "paragraph": 0,
          "start": 0,
          "end": 12.08
        },
        {
          "language": "en",
          "paragraph": 0,
          "start": 12.3,
          "end": 25.087664
        },
        {
          "language": "ar",
          "paragraph": 1,
          "start": 25.507664,
          "end": 35.987664
        },
        {
          "language": "en",
          "paragraph": 1,
          "start": 36.207664,
          "end": 46.67712
        }
      ]
    },
    {
      "id": "yusuf-cloth",
      "audio": "assets/audio/yusuf/04.mp3",
      "duration": 53.39161,
      "cues": [
        {
          "start": 0,
          "end": 23.449773,
          "text": "عاد الإخوة إلى أبيهم ليلًا يبكون. وادّعوا أن ذئبًا أكل يوسف حين تركوه عند أمتعتهم. لكن ذلك لم يحدث؛ كان يوسف في البئر."
        },
        {
          "start": 23.449773,
          "end": 53.39161,
          "text": "وجاءوا بقميصه وعليه دمٌ ليس دمه ليؤيّدوا قصتهم. لم يصدّقهم يعقوب عليه السلام، وبيّن أن أنفسهم زيّنت لهم أمرًا سيّئًا. فاختار الصبر واستعان بالله."
        }
      ],
      "segments": [
        {
          "language": "ar",
          "paragraph": 0,
          "start": 0,
          "end": 10.48
        },
        {
          "language": "en",
