      "duration": 54.294649,
      "cues": [
        {
          "start": 0,
          "end": 27.752653,
          "text": "أحد عشر كوكبًا، والشمس والقمر! ما حكاية هذه الرؤيا؟ رأى يوسف عليه السلام في منامه أنها تسجد له، فأخبر أباه يعقوب عليه السلام بما رأى."
        },
        {
          "start": 27.752653,
          "end": 54.294649,
          "text": "نصحه أبوه ألّا يخبر إخوته بالرؤيا، خوفًا أن يدبّروا له أذى. وبشّره بأن الله سيختاره، ويعلّمه فهم الرؤى، ويتمّ نعمته عليه."
        }
      ],
      "segments": [
        {
          "language": "ar",
          "paragraph": 0,
          "start": 0,
          "end": 11.84
        },
        {
          "language": "en",
          "paragraph": 0,
          "start": 12.06,
          "end": 27.332653
        },
        {
          "language": "ar",
          "paragraph": 1,
