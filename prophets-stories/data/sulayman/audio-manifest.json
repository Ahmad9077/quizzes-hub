      "cues": [
        {
          "start": 0,
          "end": 17.450658,
          "text": "نملةٌ صغيرة، وجنودٌ كثيرون. كيف فهم سليمان عليه السلام كلام هذه النملة؟"
        },
        {
          "start": 17.450658,
          "end": 40.111224,
          "text": "في وادي النمل، وقع هذا الموقف العجيب. تبدأ قصتنا بنعمةٍ وهبها الله لسليمان عليه السلام، ثم نصل معه ومع جنوده إلى الوادي."
        }
      ],
      "segments": [
        {
          "language": "ar",
          "paragraph": 0,
          "start": 0,
          "end": 7.582517
        },
        {
