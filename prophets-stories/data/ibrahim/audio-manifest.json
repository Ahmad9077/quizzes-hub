          "end": 47.50576
        }
      ]
    },
    {
      "id": "ibrahim-ending",
      "audio": "assets/audio/ibrahim/06.mp3",
      "duration": 50.912562,
      "cues": [
        {
          "start": 0,
          "end": 28.401542,
          "text": "في هذا الموقف، بيّن إبراهيم عليه السلام لقومه أن الله هو ربّهم. ثم كسر الأصنام، فحاولوا إحراقه. لكن الله جعل النار آمنةً عليه، فنجا من أذاها."
        },
        {
          "start": 28.401542,
          "end": 50.912562,
          "text": "هذه لقطةٌ من قصة إبراهيم عليه السلام، وليست قصته كاملة. لنتذكّر ما حدث: اضغط على الحدث الأول، ثم الذي جاء بعده، ثم الأخير."
        }
      ],
