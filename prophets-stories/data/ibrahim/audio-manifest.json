        },
        {
          "language": "en",
          "paragraph": 1,
          "start": 42.866916,
          "end": 57.428413
        }
      ]
    },
    {
      "id": "ibrahim-fragments",
      "audio": "assets/audio/ibrahim/02.mp3",
      "duration": 50.783515,
      "cues": [
        {
          "start": 0,
          "end": 26.005941,
          "text": "وحين ابتعد القوم، كسّر إبراهيم عليه السلام أصنامهم، وترك كبيرًا لهم. صارت الأصنام قطعًا مكسّرة، بعدما كانوا يعبدونها ويعظّمونها."
        },
        {
          "start": 26.005941,
          "end": 50.783515,
          "text": "رأى القوم ما حدث، فسألوا عمّن كسر أصنامهم. وتذكّر بعضهم فتى اسمه إبراهيم كان يذكرها بالسوء. فأرادوا أن يحضروه ويسألوه أمام الناس."
        }
      ],
      "segments": [
        {
          "language": "ar",
          "paragraph": 0,
          "start": 0,
          "end": 13.2
        },
        {
          "language": "en",
          "paragraph": 0,
          "start": 13.42,
          "end": 25.585941
        },
        {
          "language": "ar",
          "paragraph": 1,
          "start": 26.005941,
          "end": 38.245941
        },
        {
          "language": "en",
          "paragraph": 1,
          "start": 38.465941,
          "end": 50.533515
        }
      ]
    },
    {
      "id": "ibrahim-courtyard",
      "audio": "assets/audio/ibrahim/03.mp3",
      "duration": 47.589229,
      "cues": [
        {
          "start": 0,
          "end": 24.141701,
          "text": "سألوا إبراهيم إن كان هو الذي كسر أصنامهم. وجّههم إلى سؤال الأصنام إن كانت تستطيع الكلام؛ ليبيّن لهم عجز ما يعبدون. والعجز هو عدم القدرة."
        },
        {
          "start": 24.141701,
          "end": 47.589229,
          "text": "وكانوا يعرفون أنها لا تتكلّم. فبيّن لهم إبراهيم عليه السلام أنها لا تنفعهم ولا تضرّهم. تلك الأصنام لم تستطع أن تدافع حتى عن نفسها."
        }
      ],
      "segments": [
        {
          "language": "ar",
          "paragraph": 0,
          "start": 0,
          "end": 13.12
        },
        {
          "language": "en",
          "paragraph": 0,
          "start": 13.34,
          "end": 23.721701
        },
        {
          "language": "ar",
          "paragraph": 1,
          "start": 24.141701,
          "end": 36.381701
        },
        {
          "language": "en",
          "paragraph": 1,
          "start": 36.601701,
          "end": 47.339229
        }
      ]
    },
    {
      "id": "ibrahim-fire",
      "audio": "assets/audio/ibrahim/04.mp3",
      "duration": 46.914444,
      "cues": [
        {
          "start": 0,
          "end": 27.027732,
          "text": "لم يقبل القوم ما بيّنه إبراهيم عليه السلام. وقرروا إحراقه دفاعًا عن أصنامهم. أرادوا إيذاءه لأنه كشف لهم أن ما يعبدونه لا يملك لهم نفعًا."
        },
        {
          "start": 27.027732,
          "end": 46.914444,
          "text": "وألقوه في النار. كان هذا خطرًا عظيمًا، لكن الله لم يترك نبيّه للنار تؤذيه. فماذا حدث للنار بأمر الله؟"
        }
      ],
      "segments": [
        {
          "language": "ar",
          "paragraph": 0,
          "start": 0,
          "end": 12.72
        },
        {
          "language": "en",
          "paragraph": 0,
          "start": 12.94,
          "end": 26.607732
        },
        {
          "language": "ar",
          "paragraph": 1,
          "start": 27.027732,
          "end": 36.947732
        },
        {
          "language": "en",
          "paragraph": 1,
          "start": 37.167732,
          "end": 46.664444
        }
      ]
    },
    {
      "id": "ibrahim-safe",
      "audio": "assets/audio/ibrahim/05.mp3",
      "duration": 47.75576,
      "cues": [
        {
          "start": 0,
          "end": 24.324127,
          "text": "أمر الله النار أن تكون باردةً آمنةً على إبراهيم عليه السلام. فلم تؤذه النار، ونجّاه الله منها. هذه نجاةٌ أخبرنا بها القرآن."
        },
        {
          "start": 24.324127,
          "end": 47.75576,
          "text": "أراد القوم أن يضرّوا إبراهيم، لكن خطتهم لم تنجح. حفظه الله من أذاهم. ولم تكن الأصنام التي دافعوا عنها هي التي تنفع أو تحمي."
        }
      ],
      "segments": [
        {
          "language": "ar",
          "paragraph": 0,
