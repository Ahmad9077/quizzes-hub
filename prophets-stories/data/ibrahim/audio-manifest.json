      "duration": 57.679433,
      "cues": [
        {
          "start": 0,
          "end": 28.086916,
          "text": "نارٌ مشتعلة، وإبراهيم عليه السلام ينجو منها! كيف حدث ذلك؟ تبدأ قصتنا قبل النار، حين منح الله إبراهيم الرشد، أي معرفة الحق واتباعه."
        },
        {
          "start": 28.086916,
          "end": 57.678413,
          "text": "كان قومه يعبدون أصنامًا، وهي تماثيل اتخذوها آلهة. سألهم إبراهيم عنها، فقالوا إنهم وجدوا آباءهم يعبدونها. وبيّن لهم أن ربّهم هو الله، خالق السماوات والأرض."
        }
      ],
      "segments": [
        {
          "language": "ar",
          "paragraph": 0,
          "start": 0,
          "end": 12.8
        },
        {
          "language": "en",
          "paragraph": 0,
          "start": 13.02,
          "end": 27.666916
        },
        {
          "language": "ar",
          "paragraph": 1,
          "start": 28.086916,
