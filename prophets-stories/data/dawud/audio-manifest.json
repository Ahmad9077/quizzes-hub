      ]
    },
    {
      "id": "dawud-river",
      "audio": "assets/audio/dawud/02.mp3",
      "duration": 51.333628,
      "cues": [
        {
          "start": 0,
          "end": 26.681814,
          "text": "خرج طالوت بالجنود، وأخبرهم أن الله سيختبرهم بنهر. نهاهم عن الشرب منه، إلا مَن أخذ غرفةً واحدة بيده. والغرفة هنا مقدار ما تحمله اليد من ماء."
        },
        {
          "start": 26.681814,
          "end": 51.333628,
          "text": "شرب أكثر الجنود الشرب المنهيّ عنه، ولم يلتزم إلا قليل. ثم عبر طالوت النهر ومعه الذين آمنوا. وكان أمامهم لقاء جالوت وجنوده."
        }
      ],
      "segments": [
        {
          "language": "ar",
          "paragraph": 0,
          "start": 0,
          "end": 13.6
        },
        {
          "language": "en",
          "paragraph": 0,
          "start": 13.82,
          "end": 26.261814
        },
        {
          "language": "ar",
          "paragraph": 1,
          "start": 26.681814,
          "end": 38.521814
        },
        {
          "language": "en",
          "paragraph": 1,
          "start": 38.741814,
          "end": 51.083628
        }
      ]
    },
    {
      "id": "dawud-few",
      "audio": "assets/audio/dawud/03.mp3",
      "duration": 49.226735,
      "cues": [
        {
          "start": 0,
          "end": 22.468209,
          "text": "بعد عبور النهر، قال بعضهم إنهم لا يقدرون على مواجهة جالوت وجنوده. رأوا قلّة عددهم وكثرة عدوّهم، فشعروا بصعوبة اللقاء."
        },
        {
          "start": 22.468209,
          "end": 49.226735,
          "text": "لكن المؤمنين الموقنين بلقاء الله ذكّروهم بأن جماعاتٍ قليلة قد غلبت جماعاتٍ كثيرة بإذن الله، وأن الله مع الصابرين. فثبّتوهم على الصبر."
        }
      ],
      "segments": [
        {
          "language": "ar",
          "paragraph": 0,
          "start": 0,
          "end": 10.64
        },
        {
          "language": "en",
          "paragraph": 0,
          "start": 10.86,
          "end": 22.048209
        },
        {
          "language": "ar",
          "paragraph": 1,
          "start": 22.468209,
          "end": 35.348209
        },
        {
          "language": "en",
          "paragraph": 1,
          "start": 35.568209,
          "end": 48.976735
        }
      ]
    },
    {
      "id": "dawud-prayer",
      "audio": "assets/audio/dawud/04.mp3",
      "duration": 45.006576,
      "cues": [
        {
          "start": 0,
          "end": 24.800023,
          "text": "وعندما خرجوا لمواجهة جالوت وجنوده، دعوا الله أن يمنحهم صبرًا كثيرًا. وسألوه أن يثبّت أقدامهم، أي يجعلهم ثابتين فلا يفرّوا."
        },
        {
          "start": 24.800023,
          "end": 45.006576,
          "text": "وطلبوا من الله النصر على عدوّهم. كان الدعاء في هذا الموقف طلبًا للصبر والثبات والنصر، وهم مقبلون على اللقاء."
        }
      ],
      "segments": [
        {
          "language": "ar",
          "paragraph": 0,
          "start": 0,
          "end": 12
        },
        {
