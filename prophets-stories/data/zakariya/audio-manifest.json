    },
    {
      "id": "zakariya-prayer",
      "audio": "assets/audio/zakariya/02.mp3",
      "duration": 43.738798,
      "cues": [
        {
          "start": 0,
          "end": 24.14907,
          "text": "لم تكن زوجة زكريا تُنجب، وقد أصبح هو كبيرًا في السن. وكان يخشى أن يضيع أمر تعليم الناس دينهم من بعده. فسأل الله أن يرزقه ولدًا صالحًا."
        },
        {
          "start": 24.14907,
          "end": 43.738798,
          "text": "أراد ولدًا يتابع العلم والدعوة إلى الله من بعده، وسأل ربّه أن يكون هذا الولد مرضيًّا، أي صالحًا يرضى الله عنه."
        }
      ],
      "segments": [
        {
          "language": "ar",
          "paragraph": 0,
          "start": 0,
          "end": 12.24
        },
        {
          "language": "en",
          "paragraph": 0,
          "start": 12.46,
          "end": 23.72907
        },
        {
          "language": "ar",
          "paragraph": 1,
          "start": 24.14907,
          "end": 33.50907
        },
        {
          "language": "en",
          "paragraph": 1,
          "start": 33.72907,
          "end": 43.488798
        }
      ]
    },
    {
      "id": "zakariya-news",
      "audio": "assets/audio/zakariya/03.mp3",
      "duration": 54.097891,
      "cues": [
        {
          "start": 0,
          "end": 26.77644,
          "text": "استجاب الله لدعاء زكريا عليه السلام، وبشّره بغلام اسمه يحيى. والبشارة خبرٌ سار. ونادته الملائكة بهذا الخبر وهو قائمٌ يصلّي في المحراب، أي موضع عبادته."
        },
        {
          "start": 26.77644,
          "end": 54.097891,
          "text": "تعجّب زكريا عليه السلام من هذه البشارة. سأل كيف يكون له ولد، وزوجته لا تُنجب، وهو قد بلغ سنًّا كبيرة. كانت البشارة بما لم تجرِ به العادة في حالهما."
        }
      ],
      "segments": [
        {
          "language": "ar",
          "paragraph": 0,
          "start": 0,
          "end": 14.16
        },
        {
          "language": "en",
          "paragraph": 0,
          "start": 14.38,
          "end": 26.35644
        },
        {
          "language": "ar",
          "paragraph": 1,
          "start": 26.77644,
          "end": 40.21644
        },
        {
          "language": "en",
          "paragraph": 1,
          "start": 40.43644,
          "end": 53.847891
        }
      ]
    },
    {
      "id": "zakariya-sign",
      "audio": "assets/audio/zakariya/04.mp3",
      "duration": 49.059025,
      "cues": [
        {
          "start": 0,
          "end": 24.374943,
          "text": "جاءه الجواب بأن هذا الأمر هيّنٌ على الله، الذي خلق زكريا من قبل. ثم سأل زكريا عليه السلام ربّه علامةً يطمئن بها قلبه."
        },
        {
          "start": 24.374943,
          "end": 49.058073,
          "text": "كانت العلامة ألا يقدر على كلام الناس ثلاثة أيام بلياليها، مع أنه سليمٌ لا مرض يمنعه من الكلام. يستطيع أن يشير إليهم، ويذكر الله ويسبّحه."
        }
      ],
      "segments": [
        {
          "language": "ar",
          "paragraph": 0,
          "start": 0,
          "end": 11.76
        },
        {
          "language": "en",
