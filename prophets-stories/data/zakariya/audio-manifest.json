      "duration": 53.979478,
      "cues": [
        {
          "start": 0,
          "end": 27.552902,
          "text": "كيف يُحدّث نبيٌّ قومه بالإشارة وهو سليم؟ هذا ما سيحدث لزكريا عليه السلام. لكن قصتنا تبدأ قبل ذلك، حين دعا ربّه دعاءً خفيًّا، بصوتٍ منخفض."
        },
        {
          "start": 27.552902,
          "end": 53.979478,
          "text": "كان زكريا عليه السلام قد كبر في السن، وضعفت عظامه، وانتشر الشيب في رأسه. شكا إلى الله ضعفه، وذكر إحسان ربّه إليه في دعائه من قبل."
        }
      ],
      "segments": [
        {
          "language": "ar",
          "paragraph": 0,
          "start": 0,
          "end": 13.68
        },
        {
          "language": "en",
          "paragraph": 0,
          "start": 13.9,
          "end": 27.132902
        },
        {
          "language": "ar",
          "paragraph": 1,
