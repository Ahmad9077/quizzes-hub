          "end": 35.305102
        },
        {
          "language": "en",
          "paragraph": 1,
          "start": 35.525102,
          "end": 46.359705
        }
      ]
    },
    {
      "id": "ayyub-relief",
      "audio": "assets/audio/ayyub/03.mp3",
      "duration": 46.517868,
      "cues": [
        {
          "start": 0,
          "end": 22.855601,
          "text": "أزال الله ما أصاب أيوب عليه السلام من الضرّ. وأنعم عليه بأهله، وزاده مثلهم معهم. كانت هذه عطايا من رحمة الله بعد الشدّة."
        },
        {
          "start": 22.855601,
          "end": 46.517868,
          "text": "ويذكر القرآن صبر أيوب وكثرة رجوعه إلى ربّه. لم تنتهِ هذه اللقطة عند المرض والدعاء؛ استجاب الله له، ومنحه الشفاء والرحمة."
        }
      ],
      "segments": [
        {
          "language": "ar",
