    },
    {
      "id": "ayyub-spring",
      "audio": "assets/audio/ayyub/02.mp3",
      "duration": 46.609705,
      "cues": [
        {
          "start": 0,
          "end": 25.465102,
          "text": "استجاب الله لدعاء أيوب عليه السلام. وأمره أن يضرب الأرض برجله، ففعل. فخرج له ماءٌ بارد، ليغتسل منه ويشرب."
        },
        {
          "start": 25.465102,
          "end": 46.609705,
          "text": "اغتسل أيوب بالماء وشرب منه، فشفاه الله وزال عنه الأذى. كان هذا الشفاء رحمةً من الله واستجابةً لدعاء نبيّه."
        }
      ],
      "segments": [
        {
          "language": "ar",
          "paragraph": 0,
          "start": 0,
          "end": 12.48
        },
        {
          "language": "en",
